# ==========================================
# ROCO — Environment Variables
# Copie para .env.local e preencha os valores.
# NUNCA commite o .env real.
# ==========================================

# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contato (usado nos CTAs do site — em breve)
NEXT_PUBLIC_CONTACT_EMAIL=contato@roco.com.br
# Liga/desliga o formulário de contato (Mautic) sem editar código.
# "false" → modal mostra mensagem de indisponibilidade. Qualquer outro valor
# (ou ausente) → formulário habilitado. NEXT_PUBLIC_* é embutido no build,
# então mudar exige rebuild.
NEXT_PUBLIC_CONTACT_FORM_ENABLED=true
# WhatsApp do botão flutuante — somente dígitos, com DDI (55) + DDD.
# Padrão no código: 554733352012  →  (47) 3335-2012
NEXT_PUBLIC_WHATSAPP_NUMBER=554733352012

# Links externos dos CTAs da landing.
# IMPORTANTE: variáveis NEXT_PUBLIC_* são embutidas no BUILD (next build),
# então precisam estar presentes no momento do build (ex.: build args no easypanel).
# Se não forem definidas, o código usa os fallbacks em src/core/config/site.ts.
NEXT_PUBLIC_PRODUCTS_URL=
# "Baixar Catálogo": deixe VAZIO para usar a página de catálogo do próprio site
# (/{locale}/catalogo), que libera o PDF após o formulário do Mautic.
# Preencher com uma URL externa (ex.: https://catalogo.roco.com.br/catalogo-roco)
# faz o CTA apontar para fora e PULA a captura de lead.
NEXT_PUBLIC_CATALOG_URL=
# PDF do catálogo. Padrão: arquivo servido de /public (mesma origem — necessário
# para o download automático na página de catálogo).
NEXT_PUBLIC_CATALOG_PDF_URL=/downloads/catalogo-roco-2026.pdf
# Política de Privacidade (LGPD) — se definida, vira link no aviso do formulário.
NEXT_PUBLIC_PRIVACY_URL=

# Tracking de visitantes — RD Station (substituiu o Mautic em 2026-08-30).
# Só o TRACKING migrou: o formulário de contato continua no Mautic.
#
# A URL do loader da conta da ROCO já é o PADRÃO no código
# (src/shared/components/analytics/rdstation-tracking.tsx) — não precisa
# definir nada para funcionar. Só preencha para apontar a outra conta/ambiente:
# ⚠️ se o host mudar, a CSP em next.config.ts precisa liberá-lo em `script-src`,
# senão o navegador bloqueia o script sem erro visível fora do console.
NEXT_PUBLIC_RDSTATION_SCRIPT_URL=
#
# Produção: LIGADO por padrão; "false" é o interruptor de emergência.
# Desenvolvimento: DESLIGADO por padrão (não polui o lead scoring do RD com
# navegação de desenvolvedor); "true" liga para conferir o carregamento.
# NEXT_PUBLIC_* é embutido no BUILD — mudar exige rebuild da imagem.
NEXT_PUBLIC_RDSTATION_TRACKING_ENABLED=

# WhatsApp MCP (Archicode) — automações de notificação
WHATSAPP_MCP_URL=https://work.archicode.com.br/mcp-test/5b4500a6-d4ff-48d2-938f-ceb0bdbd010e

# RD Station — Conversions API. Credencial de SERVIDOR (nunca NEXT_PUBLIC_):
# ela é usada só pelo Route Handler POST /api/rd-lead, que encaminha ao RD o
# lead que o formulário do Mautic acabou de aceitar. Um POST feito do navegador
# exporia a chave no código-fonte da página — daí a rota existir.
#
# Onde gerar: painel do RD > Integrações > API Keys (exige perfil Gestor ou
# Proprietário). NÃO confunda com o par "token público / token privado", que
# pertence à API LEGADA 1.3 e devolve 401 neste endpoint.
#
# Sem esta variável a rota apenas registra um WARN e não envia nada: o lead
# continua sendo capturado pelo Mautic normalmente.
#
# CAMPOS PERSONALIZADOS usados (criar no painel: Configurações > Campos
# personalizados) — cf_cnpj, cf_mensagem, cf_origem. Os demais campos enviados
# (name, email, personal_phone, city, state) são PADRÃO e não exigem cadastro.
# ⚠️ O RD responde HTTP 200 mesmo para um cf_ que NÃO existe: campo
# desconhecido é descartado em silêncio, sem erro em lugar nenhum. Conferir os
# valores abrindo um contato no painel — a API Key não autoriza leitura.
RD_STATION_API_KEY=

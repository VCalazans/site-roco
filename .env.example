# ==========================================
# ROCO — Environment Variables
# Copie para .env.local e preencha os valores.
# NUNCA commite o .env real.
# ==========================================

# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contato (usado nos CTAs do site — em breve)
NEXT_PUBLIC_CONTACT_EMAIL=contato@roco.com.br
# Liga/desliga o formulário de contato (Mautic) sem editar código.
# "false" → modal mostra mensagem de indisponibilidade. Qualquer outro valor
# (ou ausente) → formulário habilitado. NEXT_PUBLIC_* é embutido no build,
# então mudar exige rebuild.
NEXT_PUBLIC_CONTACT_FORM_ENABLED=true
# WhatsApp do botão flutuante — somente dígitos, com DDI (55) + DDD.
# Padrão no código: 554733352012  →  (47) 3335-2012
NEXT_PUBLIC_WHATSAPP_NUMBER=554733352012

# Links externos dos CTAs da landing.
# IMPORTANTE: variáveis NEXT_PUBLIC_* são embutidas no BUILD (next build),
# então precisam estar presentes no momento do build (ex.: build args no easypanel).
# Se não forem definidas, o código usa os fallbacks em src/core/config/site.ts.
NEXT_PUBLIC_PRODUCTS_URL=
# "Baixar Catálogo": deixe VAZIO para usar a página de catálogo do próprio site
# (/{locale}/catalogo), que libera o PDF após o formulário do Mautic.
# Preencher com uma URL externa (ex.: https://catalogo.roco.com.br/catalogo-roco)
# faz o CTA apontar para fora e PULA a captura de lead.
NEXT_PUBLIC_CATALOG_URL=
# PDF do catálogo. Padrão: arquivo servido de /public (mesma origem — necessário
# para o download automático na página de catálogo).
NEXT_PUBLIC_CATALOG_PDF_URL=/downloads/catalogo-roco-2026.pdf
# Política de Privacidade (LGPD) — se definida, vira link no aviso do formulário.
NEXT_PUBLIC_PRIVACY_URL=

# Tracking de visitantes (Mautic mtc.js — cópia self-hosted em /vendor).
# Produção: ligado por padrão; "false" desliga (útil se o jurídico exigir
# consentimento antes do tracking — não há banner de cookies neste site).
# Desenvolvimento: DESLIGADO por padrão para não poluir as estatísticas e a
# atribuição de leads do Mautic com acessos de localhost; use "true" para testar.
# NEXT_PUBLIC_* é embutido no build, então mudar exige rebuild.
NEXT_PUBLIC_MAUTIC_TRACKING_ENABLED=false

# WhatsApp MCP (Archicode) — automações de notificação
WHATSAPP_MCP_URL=https://work.archicode.com.br/mcp-test/5b4500a6-d4ff-48d2-938f-ceb0bdbd010e

# ==========================================
# Formulário de contato (RD Station + e-mail transacional)
# POST /api/contact — ver memory-bank/decisionLog.md.
# ==========================================

# RD Station — Conversions API (lead do formulário de contato). API Key estática,
# gerada no painel do RD Station (Integrações > API Key). A chave viaja na
# QUERYSTRING da requisição (contrato da API Key — não há Bearer neste endpoint):
# nunca logue a URL montada.
#
# CAMPOS CUSTOMIZADOS a criar MANUALMENTE no painel do RD (Configurações >
# Campos personalizados) ANTES do primeiro envio — a API Key não tem permissão
# para criá-los (só OAuth cria campo):
#   cf_cnpj               → CNPJ informado no formulário
#   cf_produto_interesse  → produto que originou o pedido de orçamento
#   cf_origem             → SEÇÃO DO SITE de onde partiu o clique (hero, rodapé,
#                           detalhe de produto…). Lista fechada em
#                           src/shared/lib/lead-origin.ts.
#
# Se algum deles faltar, o RD responde 400 e a conversão INTEIRA se perderia.
# Por isso a rota degrada: no 400, reenvia UMA vez só com os campos padrão
# (nome/e-mail/telefone chegam de qualquer jeito) e marca
# contact_submissions.rd_station_error = "validation_retry_ok" — o lead entrou,
# mas o painel precisa de ajuste. Confira essa coluna depois do go-live.
#
# UTM (utm_source/utm_medium/utm_campaign) NÃO precisa de configuração nenhuma:
# vai nos campos padrão traffic_source/traffic_medium/traffic_campaign.
RD_STATION_API_KEY=

# Resend — envio do e-mail de notificação do formulário de contato para o time
# comercial. Requer domínio de envio verificado no painel Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Destino do e-mail de notificação. Se vazio, cai para NEXT_PUBLIC_CONTACT_EMAIL.
CONTACT_NOTIFICATION_EMAIL=

# ==========================================
# Portal/CRM (Auth.js, RBAC, catálogo, representantes)
# Ver memory-bank/decisionLog.md, entradas de 2026-08-09.
# ==========================================

# Postgres (docker-compose sobe um serviço local com estas credenciais).
# Em produção gerenciada, aponte DATABASE_URL para a instância real.
POSTGRES_USER=roco
POSTGRES_PASSWORD=roco
POSTGRES_DB=roco_portal
DATABASE_URL=postgres://roco:roco@localhost:5432/roco_portal

# Carga inicial de PRODUCAO (npm run db:bootstrap-producao).
# Coloque a connection string de producao em .env.producao.local (gitignored),
# NAO aqui e NAO em DATABASE_URL: o nome separado evita o classico "esqueci de
# reverter e meu ambiente local esta apontando para producao".
# PRODUCTION_DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Redis (fila BullMQ do sync ERP + rate limiting das rotas públicas).
#
# ⚠️ OBRIGATÓRIA EM PRODUÇÃO. Os dois limites de POST /api/contact são
# `productionSafe: true` (fail-closed): sem Redis a rota responde 503 e NENHUM
# lead de /contato ou /catalogo é capturado. Em desenvolvimento pode ficar
# vazia — os limites fail-open e o único efeito é um WARN no log.
REDIS_URL=redis://localhost:6379

# Auth.js v5. Gere um valor forte com `npx auth secret` — NUNCA reutilize
# entre ambientes. AUTH_URL só é necessária fora da Vercel (ex.: Docker/VPS).
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Domínio de e-mail considerado "time interno" — usuários com este domínio
# ganham a role `viewer` no primeiro login; os demais ganham `representative`.
PORTAL_INTERNAL_EMAIL_DOMAIN=roco.com.br

# Usuário admin do login tradicional (e-mail + senha). Criado/atualizado pelo
# `npm run db:seed` SOMENTE quando as duas envs estão definidas — não existe
# senha padrão no código. Mínimo de 12 caracteres; troque após o primeiro
# acesso e remova as envs do ambiente de produção depois do bootstrap.
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=

# Cloudflare R2 (imagens de produto) — upload via presigned URL, sem taxa de
# egress. R2_PUBLIC_URL é o domínio público do bucket (custom domain ou r2.dev).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=roco-portal
R2_PUBLIC_URL=

# Segredo compartilhado para validar a assinatura do webhook do ERP
# (endpoint /api/webhooks/erp — onda 2). Nunca commitar o valor real.
ERP_WEBHOOK_SECRET=

# ==========================================
# Operação: workers e observabilidade
# ==========================================

# Liga/desliga os workers BullMQ DENTRO deste processo (fila erp-sync,
# registrada por instrumentation.ts no boot).
#
# Desliga SOMENTE com o valor exato "false" (ignorando espaços e caixa).
# Ausente, vazia ou qualquer outro valor => LIGADO. Nenhum ambiente existente
# muda de comportamento por omissão desta variável.
#
# PARA QUE SERVE: isolar CPU. Toda réplica sobe o seu próprio worker, que
# processa o sync ERP no MESMO event loop que renderiza página — e o gargalo
# medido deste sistema é exatamente CPU de event loop. Ao escalar
# horizontalmente, a receita é: SERVIÇO web com WORKERS_ENABLED=false +
# SERVIÇO worker separado (mesma imagem, mesmo REDIS_URL) com a flag ligada.
#
# Env é definida por SERVIÇO, não por réplica: num compose/EasyPanel/K8s não
# existe "algumas réplicas com a flag" — o valor vale para todas as réplicas
# daquele serviço. Por isso o serviço worker precisa existir de fato.
#
# ⚠️ DESLIGAR AQUI SEM TER UM CONSUMIDOR EM ALGUM LUGAR É FALHA SILENCIOSA:
# POST /api/webhooks/erp continua enfileirando e respondendo 202 { queued },
# o ERP registra sucesso em todo envio e NINGUÉM processa — o catálogo para
# de sincronizar sem um único erro. Confira o campo `workers` no ramo
# autenticado de GET /api/health (running/reason) depois de mexer nisto.
#
# NÃO desligue por medo de "job duplicado": o BullMQ entrega cada job a um
# único worker (reivindicação atômica), e o jobId por minuto ainda deduplica
# na entrada. Vários consumidores na mesma fila é o modo normal e seguro.
#
# POR QUE NÃO BASTA "não definir REDIS_URL": o Redis também é o backend do
# rate limit, e os dois limites de POST /api/contact são fail-closed
# (productionSafe: true) — tirar o Redis para desligar o worker desligaria
# junto a captação de leads do site (503 em /contato e /catalogo).
WORKERS_ENABLED=true

# Segredo que libera as MÉTRICAS DETALHADAS de GET /api/health (uptime,
# atraso do event loop em janela curta + acumulado, contadores do pool de
# conexões e estado do worker BullMQ). Enviado no header `x-health-token` e
# comparado em tempo constante. Espaços/quebras de linha em volta do valor
# são ignorados (colar de painel de deploy costuma trazer um \n no fim).
#
# Sem esta variável, as métricas simplesmente não são expostas a ninguém:
# a rota responde só { status: "ok" }, que é o que o healthcheck da
# plataforma precisa. Token errado devolve exatamente essa mesma resposta
# (nunca 401) — um 401 confirmaria que existe segredo configurado e daria o
# sinal de acerto/erro que torna força bruta viável.
#
# POR QUE PROTEGER MÉTRICA: `waiting` do pool e o atraso do event loop são um
# oráculo de saturação — expostos publicamente, deixam qualquer um medir em
# tempo real se a carga que ele está gerando está funcionando.
#
# Adicione `?db=1` (também só com o token) para incluir um SELECT 1 no banco;
# sem essa flag a rota não toca no banco. Pool cheio devolve
# database.status = "pool_saturated" com HTTP 200 — saturação NUNCA reprova o
# health check, senão o orquestrador mataria justamente o container ocupado.
# Só falha real de conexão (recusa/DNS/auth) devolve "degraded" + 503.
#
# ⚠️ O healthcheck da plataforma deve apontar para /api/health SEM token: ele
# é LIVENESS ("o processo aceita HTTP?") e responde 200 incondicionalmente.
# Ele NÃO detecta migration quebrada — o CMD do Dockerfile usa `||` de
# propósito para o servidor subir mesmo se scripts/migrate.mjs falhar. Para
# saber se o DEPLOY está são, confira as linhas `[migrate]` no log do
# container.
HEALTH_METRICS_TOKEN=
